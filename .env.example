# Copy to .env at the repository root.
PORT=3000
NODE_ENV=development
PROOF_MODE=mock
BLOCKCHAIN_MODE=mock
RPC_URL=http://127.0.0.1:8545

# For the local blockchain demo, set both modes above to real, start
# `npx hardhat node`, then run `npm run deploy:local` in another terminal.
# The deploy script writes CONTRACT_ADDRESS to .env. The backend defaults
# to Hardhat's public local development account when PRIVATE_KEY is omitted.
# For a different network, configure credentials only in your local .env.
# PRIVATE_KEY=your_wallet_private_key
# CONTRACT_ADDRESS=your_deployed_verity_manager_address

CONTRACT_ABI_PATH=deployments/abi/VerityManager.json
CIRCUIT_WASM_PATH=build/credit_score_js/credit_score.wasm
CIRCUIT_ZKEY_PATH=build/credit_score_final.zkey
VERIFICATION_KEY_PATH=build/verification_key.json
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
