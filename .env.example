# Verity Finance — root environment (Hardhat chain + shared ZK artifacts)
# Copy once: copy .env.example .env  (Windows)  or  cp .env.example .env  (Mac)
# Never commit real keys (see .gitignore).

# --- Hardhat / chain ---
BSC_TESTNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# --- Backend (same keys, consumed by backend/src/config/index.ts via PROJECT_ROOT/.env) ---
PORT=3000
NODE_ENV=development
PROOF_MODE=mock
BLOCKCHAIN_MODE=mock
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=
CONTRACT_ADDRESS=
CONTRACT_ABI_PATH=deployments/abi/VerityManager.json
CIRCUIT_WASM_PATH=build/credit_score_js/credit_score.wasm
CIRCUIT_ZKEY_PATH=build/credit_score_final.zkey
VERIFICATION_KEY_PATH=build/verification_key.json
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
