# Verity Finance Backend Configuration
PORT=3000
NODE_ENV=development

# Mode configuration: "mock" or "real"
# In mock mode, simulated proofs and in-memory blockchain tasks are used for testing.
# In real mode, Groth16 zk-SNARK generation via snarkjs and live ethers.js contract calls are required.
PROOF_MODE=mock
BLOCKCHAIN_MODE=mock

# Blockchain Configuration (Ethers.js v6)
# Used when BLOCKCHAIN_MODE=real
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=
CONTRACT_ADDRESS=
CONTRACT_ABI_PATH=../deployments/abi/VerityManager.json

# Zero-Knowledge Circuit Artifacts (snarkjs / Groth16)
# Used when PROOF_MODE=real
CIRCUIT_WASM_PATH=../build/credit_score_js/credit_score.wasm
CIRCUIT_ZKEY_PATH=../build/credit_score_final.zkey
VERIFICATION_KEY_PATH=../build/verification_key.json
WITNESS_GENERATOR_PATH=../build/credit_score_js/credit_score.wasm

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
